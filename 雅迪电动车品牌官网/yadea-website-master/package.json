{
  "private": true,
  "packageManager": "pnpm@7.9.0",
  "scripts": {
    "dev": "nuxt dev --port 8003 --mode dev",
    "test": "nuxt dev --port 8004 --mode test",
    "prod": "nuxt dev --port 8005 --mode prod",
    "build-test": "nuxt build --mode test",
    "build-prod": "nuxt build --mode prod",
    "build-local": "nuxt build --mode localhost",
    "start": "cross-env PORT=8080 node .output/server/index.mjs",
    "pm2": "pm2 start ecosystem.config.js --env production",
    "lint": "eslint . --ext .ts,.js,.vue",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "generate": "nuxt generate --mode generate",
    "clean-lh": "rimraf .lh",
    "clean-node_modules": "rimraf node_modules",
    "local": "node .output/server/index.mjs",
    "fix-memory-limit": "increase-memory-limit",
    "fix-memory-limit0": "cross-env LIMIT=8096 increase-memory-limit"
  },
  "devDependencies": {
    "@css-render/vue3-ssr": "^0.15.11",
    "@pinia/nuxt": "^0.4.3",
