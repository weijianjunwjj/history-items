{
  "name": "arco-design-pro-vue",
  "description": "Arco Design Pro for Vue",
  "version": "1.0.0",
  "private": true,
  "author": "ArcoDesign Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.ts",
    "build:dev": "vite build --mode production.dev --config ./config/vite.config.ts",
    "build": "vite build --config ./config/vite.config.ts",
    "report": "cross-env REPORT=true npm run build",
    "lint-staged": "npx lint-staged",
    "prepare": "husky install",
    "lint": "eslint src/**/*.{vue,js,jsx,ts,tsx} --fix"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.25.0",
    "@types/js-cookie": "^3.0.2",
    "@types/mockjs": "^1.0.4",
    "@types/moment": "^2.13.0",
    "@types/qs": "^6.9.7",
    "@vueup/vue-quill": "1.0.0-beta.8",
    "@vueuse/core": "^7.3.0",
    "arco-design-pro-vue": "^2.5.8",
    "axios": "^0.24.0",
    "echarts": "^5.2.2",
    "js-cookie": "^3.0.1",
    "lodash": "^4.17.21",
    "mitt": "^3.0.0",
    "moment": "^2.29.3",
    "moment-duration-format": "^2.3.2",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.9",
    "qs": "^6.10.3",
    "quill-blot-formatter": "1.0.5",
    "quill-image-uploader": "1.2.2",
    "tim-js-sdk": "^2.15.0",
    "tim-upload-plugin": "^1.0.3",
    "trtc-calling-js": "^1.0.3",
    "trtc-js-sdk": "^4.11.10",
    "tsignaling": "^0.9.0",
    "unplugin-auto-import": "^0.7.1",
    "vue": "^3.2.31",
    "vue-cropper": "1.0.5",
    "vue-echarts": "^6.0.0",
    "vue-i18n": "^9.2.0-beta.17",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^12.0.1",
    "@types/lodash": "^4.14.177",
    "@types/moment-duration-format": "^2.2.3",
    "@types/nprogress": "^0.2.0",
    "@types/trtc-calling-js": "^0.6.2",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "@vitejs/plugin-vue": "^1.9.4",
    "@vitejs/plugin-vue-jsx": "^1.2.0",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.7.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^8.3.0",
    "husky": "^7.0.4",
    "less": "^4.1.2",
    "lint-staged": "^11.2.6",
    "mockjs": "^1.1.0",
    "prettier": "^2.2.1",
    "rollup-plugin-visualizer": "^5.6.0",
    "stylelint": "^13.8.0",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-rational-order": "^0.1.2",
